<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Pulsar Watch App</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>PulsarWatch</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>NSHealthShareUsageDescription</key>
	<string>Pulsar reads sleep, heart rate, activity, and workout data from Apple Health on Apple Watch to show today's Sleep, Recovery, Strain, and live workout context.</string>
	<key>NSHealthUpdateUsageDescription</key>
	<string>Pulsar saves running and gym workouts, routes when available, distance, active calories, and workout metrics to Apple Health from Apple Watch.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Pulsar uses location during outdoor runs to show distance, pace, elevation, and your route.</string>
	<key>NSMotionUsageDescription</key>
	<string>Pulsar uses motion data on Apple Watch to support workout detection, cadence, and live workout context.</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
	</array>
	<key>WKApplication</key>
	<true/>
	<key>WKBackgroundModes</key>
	<array>
		<string>workout-processing</string>
		<string>location</string>
	</array>
	<key>WKCompanionAppBundleIdentifier</key>
	<string>aetherial.Pulsar</string>
</dict>
</plist>
